{
  "manifest_version": 3,
  "name": "Guardian - URL Threat Protection",
  "version": "0.1.0",
  "description": "Checks every site you open against a trusted list, PhishTank, Google Safe Browsing and VirusTotal before the page loads.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Guardian",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "tabs", "webNavigation", "alarms"],
  "host_permissions": [
    "https://safebrowsing.googleapis.com/*",
    "https://www.virustotal.com/*",
    "https://data.phishtank.com/*",
    "https://cdn.phishtank.com/*"
  ]
}
